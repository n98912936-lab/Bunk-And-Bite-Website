PORT=3000

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/bunkandbite
MONGODB_URI=

# Password for the Admin panel (choose your own strong password).
# Whoever knows this password can add/edit/delete products, so keep it private.
ADMIN_PASSWORD=

# Razorpay: create a merchant account and put the server-side credentials here.
# Never put RAZORPAY_KEY_SECRET in public/index.html or any frontend file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Later, add real notification providers here if desired:
# OWNER_EMAIL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
